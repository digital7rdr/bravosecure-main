NODE_ENV=development
PORT=3100
# AUDIT-2026-08-13 #6 — push-token App Check gate (app-check.guard.ts).
# warn-only | enforce | disabled. Unset in dev = warn-only; unset under
# NODE_ENV=production FAILS CLOSED on /push/* (401; logged at boot AND
# recurring 1/min at the rejection site so it survives log rotation).
APP_CHECK_MODE=warn-only
JWT_ACCESS_SECRET=
JWT_ACTION_SECRET=
JWT_ISSUER=auth-service
JWT_AUDIENCE=bravo-api
JWT_ACTION_AUDIENCE=bravo-action
REDIS_URL=redis://127.0.0.1:6379
RELAY_DWELL_SECONDS=2592000
RELAY_MAX_PULL_LIMIT=100
RELAY_MAX_CIPHERTEXT_BYTES=262144
TURN_STATIC_AUTH_SECRET=
TURN_TTL_SECONDS=86400
# UDP+TCP both — see comment in apps/messenger-service/src/config/configuration.ts.
# 127.0.0.1 is ONLY valid for emulator dev with `adb reverse tcp:3478 tcp:3478`;
# real devices on a LAN must hit the host's LAN IP (e.g. 192.168.1.x).
TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
TURN_STUN_URLS=stun:stun.l.google.com:19302
WS_HEARTBEAT_MS=30000
# B-05 — pong grace window (socket.io pingTimeout). MUST stay >= 25000:
# at 10000 a late pong under Contabo/TURN latency spikes reaped the socket
# and kicked every participant of a live call at once (the QA "all calls
# drop after 2–14 min" finding). The code default is already 25000; this
# example previously shipped 10000 and would silently override the fix on
# any deploy that copied it verbatim.
WS_HEARTBEAT_GRACE=25000
# OR-5/SRV-07 — socket.io connectionStateRecovery (2-min missed-broadcast replay
# for typing/presence/SFU/mission frames). OFF by default. The session buffer is
# per-process, so only set this to true on a SINGLE-REPLICA deployment or behind
# sticky sessions. Does NOT affect envelope delivery (direct socket.emit, never
# buffered) — the catch-up drain still owns that.
WS_SESSION_RECOVERY=false
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=bravo-messenger-media
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# ── Supabase (Postgres via PostgREST) ────────────────────────────────────
# REQUIRED IN PRODUCTION. BackupService (message/identity backup + Merkle
# commits) and UserPrivacyService reach Postgres through PostgREST with the
# service-role key, which bypasses RLS. If either value is empty the service
# logs `backup.disabled` / `privacy.disabled` and runs on with those features
# dead — so with NODE_ENV=production the process now refuses to boot instead.
# Project ref is the one in EXPO_PUBLIC_SUPABASE_URL; the service-role key is
# in Supabase Dashboard -> Project Settings -> API. NEVER ship this key to a
# client — it bypasses every row-level security policy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
