<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:enforceNavigationBarContrast" tools:targetApi="29">true</item>
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:statusBarColor">#07090D</item>
    <!-- Why: system autofill paints filled inputs yellow, clashing with the obsidian UI;
         transparent highlight keeps autofill functional without the overlay (API 26+). -->
    <item name="android:autofilledHighlight" tools:targetApi="26">@android:color/transparent</item>
    <!-- B-646 r3 — the booking time/date fields open the PLATFORM pickers now, so the
         dialogs must wear the obsidian/cobalt palette instead of the stock light
         Material one. These two attributes are the only hook: the framework builds
         TimePickerDialog / DatePickerDialog from the ACTIVITY theme, so a JS-side prop
         cannot reach them. -->
    <item name="android:timePickerDialogTheme" tools:targetApi="21">@style/BravoPickerDialog</item>
    <item name="android:datePickerDialogTheme" tools:targetApi="21">@style/BravoPickerDialog</item>
    <item name="android:alertDialogTheme">@style/BravoPickerDialog</item>
  </style>

  <!-- Obsidian dialog surface + cobalt accent. Parented on the DARK Material dialog
       (not .Light) so every unlisted attribute already lands dark rather than
       inheriting a white scrim. `colorAccent` drives the clock's selector circle,
       the selected numerals and the OK/Cancel labels; `textColorPrimary` the dial
       numerals; `colorBackground` the sheet itself. -->
  <style name="BravoPickerDialog" parent="android:Theme.Material.Dialog.Alert">
    <item name="android:colorAccent">@color/pickerAccent</item>
    <item name="android:colorControlActivated">@color/pickerAccent</item>
    <item name="android:colorBackground">@color/pickerSurface</item>
    <item name="android:windowBackground">@color/pickerSurface</item>
    <item name="android:textColorPrimary">@color/pickerText</item>
    <item name="android:textColorSecondary">@color/pickerTextDim</item>
    <item name="android:textColorPrimaryInverse">@color/pickerSurface</item>
    <!-- B-646 r4 — style the clock face itself, not just the sheet colours. -->
    <item name="android:timePickerStyle">@style/BravoTimePicker</item>
    <item name="android:buttonBarButtonStyle">@style/BravoPickerButton</item>
  </style>

  <!-- B-646 r4 — the clock: cobalt-navy header (selected time + AM/PM), a
       lifted dial face, cobalt selector hand, platinum numerals. This is what
       makes the platform picker read as OURS instead of stock Material. -->
  <style name="BravoTimePicker" parent="android:Widget.Material.TimePicker">
    <item name="android:headerBackground">@color/pickerHeader</item>
    <item name="android:numbersBackgroundColor">@color/pickerDial</item>
    <item name="android:numbersSelectorColor">@color/pickerAccent</item>
    <item name="android:numbersTextColor">@color/pickerText</item>
    <item name="android:numbersInnerTextColor">@color/pickerTextDim</item>
  </style>

  <!-- Sentence-case cobalt OK/Cancel — ALL-CAPS grey buttons are the one part
       of the stock dialog that still shouted "system default". -->
  <style name="BravoPickerButton" parent="android:Widget.Material.Button.Borderless.Colored">
    <item name="android:textColor">@color/pickerAccent</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:letterSpacing">0.02</item>
  </style>
  <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
    <item name="android:windowSplashScreenBehavior">icon_preferred</item>
  </style>
</resources>