+    /**
+     * Bravo patch — Android 12+ (API 31) communication routing.
+     *
+     * `setSpeakerphoneOn()` was deprecated in API 31 and is now a thin
+     * compatibility shim over the communication-route request stack:
+     * `true` registers a request for the built-in speaker, and `false` only
+     * CLEARS a request this app previously made (`AudioDeviceBroker.
+     * setSpeakerphoneOn` -> `if (!isSpeakerphoneOnRequested(...)) return false`).
+     * Two consequences the original code cannot express:
+     *
+     *   1. "false" cannot ASK for the earpiece. It can only withdraw a speaker
+     *      request and let the framework fall back to its own default — which is
+     *      the wired headset, or a connected Bluetooth device, whenever one is
+     *      present. There is no way to say "earpiece, specifically".
+     *   2. `setSpeakerphoneOn`'s caller-side guard (`enable !=
+     *      audioManager.isSpeakerphoneOn()`) reads the framework's CURRENT route,
+     *      not our request. When the two agree by coincidence the call is skipped
+     *      entirely, so no request of ours is ever registered and the framework
+     *      is free to re-route the moment another device appears — the B-236
+     *      "speaker toggle reverted to bt_sco_hs on the next
+     *      updateCommunicationRoute" capture.
+     *
+     * `setCommunicationDevice(AudioDeviceInfo)` is the replacement API: it names
+     * the exact device and registers a durable request. Idempotent by contract,
+     * so no is-it-already-there short-circuit here — re-issuing is how the
+     * request survives another app or another route touching the stack.
+     *
+     * Returns false when the modern path is unavailable or the device is not
+     * enumerable, so the caller keeps the legacy behaviour verbatim.
+     */
+    private boolean bravoSetCommunicationDevice(int... preferredTypes) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) {
+            return false;
+        }
+        try {
+            java.util.List<AudioDeviceInfo> available = audioManager.getAvailableCommunicationDevices();
+            for (int type : preferredTypes) {
+                for (AudioDeviceInfo info : available) {
+                    if (info.getType() != type) {
+                        continue;
+                    }
+                    // Parity with setSpeakerphoneOn(), which also asserted the mode
+                    // before routing: a communication route is only honoured while
+                    // the device is in MODE_IN_COMMUNICATION.
+                    audioManager.setMode(defaultAudioMode);
+                    boolean ok = audioManager.setCommunicationDevice(info);
+                    Log.d(TAG, "bravoSetCommunicationDevice(type=" + type + ") -> " + ok);
+                    return ok;
+                }
+            }
+            Log.d(TAG, "bravoSetCommunicationDevice: no match; " + available.size() + " device(s) enumerated");
+        } catch (Exception e) {
+            Log.w(TAG, "bravoSetCommunicationDevice failed", e);
+        }
+        return false;
+    }
